# ============================================================
# Agbot agent configuration  (copy to .env and edit)
# ============================================================

# ---------- remote model (SGLang on the GPU box) -----------
# Point this at the effort-proxy (recommended) or straight at SGLang:
#   effort-proxy : http://127.0.0.1:30001/v1   (via SSH tunnel, see deploy/README.md)
#   sglang direct: http://127.0.0.1:30000/v1
AGENT_BASE_URL=
AGENT_API_KEY=EMPTY
AGENT_MODEL=deepseek-v4.1-flash-crack

# ---------- generation --------------------------------------
# reasoning effort tiers: low | high | xhigh | max   (lower = snappier agent loops)
AGENT_REASONING_EFFORT=low
# auto | on | off  -- whether to send reasoning_effort to the server
AGENT_SEND_REASONING_EFFORT=auto
AGENT_MAX_TOKENS=32768
AGENT_TEMPERATURE=1.0
AGENT_TOP_P=0.95

# ---------- behavior ----------------------------------------
AGENT_MAX_STEPS=12
# on = ask before run_shell / write_file / replace_in_file, off = auto-approve (--yolo)
AGENT_APPROVAL=on
AGENT_SHOW_REASONING=on
AGENT_CONTEXT_BUDGET_CHARS=600000
AGENT_WORKSPACE=
AGENT_SESSION_DIR=sessions
AGENT_SHELL=

# ---------- local fallback (Ollama) -------------------------
AGENT_FALLBACK_OLLAMA=1
AGENT_OLLAMA_URL=http://127.0.0.1:11434
AGENT_OLLAMA_MODEL=qwen3:8b
