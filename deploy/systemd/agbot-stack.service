[Unit]
Description=Agbot model stack (SGLang DSV4.1 + effort proxy)
Documentation=file:///opt/agbot/deploy/README.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/agbot/deploy
# compose already sets restart: unless-stopped for both services
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
