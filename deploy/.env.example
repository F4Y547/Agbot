# ---- deploy/.env  (copy from .env.example) ----

# REQUIRED: Hugging Face token with access to the model repo
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Model + parallelism
MODEL_ID=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-FP8
# 4xH200: TP4 requires EP4 (moe_intermediate_size 2304 is not divisible by TP4).
# 8xH200: use TP_SIZE=8 and delete the --ep-size line from docker-compose.yml.
TP_SIZE=4
EP_SIZE=4

# Context vs concurrency (KV bytes/token = 890 B):
#   1,048,576 -> 12 concurrent | 262,144 -> 80 | 65,536 -> 320+
# Keep context at 262144 for agent use unless you really need 1M.
CONTEXT_LENGTH=262144
MEM_FRACTION_STATIC=0.85
MAX_RUNNING_REQUESTS=12

# Engram host table: 1 = ~200 GB host RAM used, frees ~46 GiB/GPU for KV.
# Set 0 on boxes with less than ~1 TB RAM (then expect 122 GB/GPU weight load).
ENGRAM_HOST_TABLE=1

# Reasoning defaults
SERVER_REASONING_EFFORT=max     # server-side default when a request omits it
PROXY_EFFORT=max                # what the proxy injects when a client omits reasoning_effort

# Networking: keep 127.0.0.1 and use an SSH tunnel; change only with a firewall rule.
PROXY_BIND=127.0.0.1

SERVED_MODEL_NAME=deepseek-v4.1-flash-crack
